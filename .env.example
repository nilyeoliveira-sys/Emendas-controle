# Copie este arquivo para ".env" e ajuste os valores antes de rodar o servidor.

# Porta do servidor HTTP
PORT=3000

# Segredo usado para assinar o token de sessao (JWT). Use uma string longa e aleatoria em producao.
JWT_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio

# Caminho do arquivo de banco de dados SQLite
DATABASE_FILE=./data/emendas.db

# Credenciais do administrador criado automaticamente na primeira execucao (npm run seed)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.gov.br
ADMIN_SENHA=troque-esta-senha

# "production" ativa cookies seguros (exige HTTPS). Deixe "development" para rodar localmente.
NODE_ENV=development
